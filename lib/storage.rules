rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads go through /api/admin/team-image (Admin SDK), which checks the
    // image type, size and rate; clients never write Storage directly.
    match /team-images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // other folders can have different rules
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}