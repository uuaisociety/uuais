rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || request.auth.token.superAdmin == true);
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    // Helper: fetch caller's user profile
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isMember() {
      return isSignedIn() && callerProfile().data.isMember == true;
    }

    // Helper: users may only write their email when it matches the verified auth email (or omit it); allow if unverifiable
    function emailMatchesAuth() {
      return !('email' in request.resource.data)
        || request.auth.token.email == null
        || request.resource.data.email == request.auth.token.email;
    }

    // Helper: limit updates to only specific keys
    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Helper: an optional string field is absent, or a string within `max`
    function strWithin(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // Profile fields partners see next to a shared CV: bounded so a member can't
    // bloat the partner page (or its zip index) with megabyte-sized values.
    function partnerVisibleFieldsOk(d) {
      return strWithin(d, 'name', 100)
        && strWithin(d, 'displayName', 100)
        && strWithin(d, 'email', 254)
        && strWithin(d, 'program', 150)
        && (!('expectedGraduationYear' in d) || d.expectedGraduationYear == null
          || (d.expectedGraduationYear is int
            && d.expectedGraduationYear >= 1950 && d.expectedGraduationYear <= 2100));
    }

    // Helper: a shared CV implies partner contact, so the opt-in stays on while cvs/{uid} exists.
    function cvOptInKept(uid) {
      return !exists(/databases/$(database)/documents/cvs/$(uid))
        || request.resource.data.get('partnerContactOptIn', false) == true;
    }

    // Helper: rules cannot iterate, but the tag list is capped, so each slot is checked by index
    function tagWithin(tags, i, max) {
      return tags.size() <= i || (tags[i] is string && tags[i].size() > 0 && tags[i].size() <= max);
    }

    // Validate shape of an eventCustomQuestions document
    function validEventCustomQuestion(d) {
      return d.eventId is string && d.eventId.size() > 0
        && d.question is string && d.question.size() > 0
        && d.type in ['text','textarea','select','checkbox','radio','file']
        && d.required is bool
        && d.order is number
        && (
          // For option-based types, options must exist and be a list
          (d.type in ['select','checkbox','radio'] && ('options' in d) && d.options is list)
          // For free-text and file types, options must be absent or an empty list
          || (d.type in ['text','textarea','file'] && (!('options' in d) || (d.options is list && d.options.size() == 0)))
        );
    }

    // USERS (member profiles)
    match /users/{uid} {
      // Users may read their own profile; admins may read all; optionally open some fields publicly later.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      // Create own document at first sign-in or profile completion.
      // NOTE: isMember is intentionally self-assertable here (self-declared membership, a deliberate product decision); afterwards it is admin-managed (update rule below).
      allow create: if isSignedIn() && request.auth.uid == uid
        && emailMatchesAuth()
        // Limit client-writable fields; prevent role escalation
        && request.resource.data.keys().hasOnly([
          'displayName','email','photoURL','isMember','studentStatus','campus','university','expectedGraduationYear','linkedin','github','website','bio','name','gender','program','heardOfUs','newsletter','lookingForJob','privacyAcceptedAt','marketingOptIn','analyticsOptIn','partnerContactOptIn','createdAt','updatedAt','unsubscribedFromEmails'
        ])
        && partnerVisibleFieldsOk(request.resource.data)
        // Re-creating a profile while a CV is still shared must keep partner contact on too.
        && cvOptInKept(uid);

      // Update own doc but cannot alter privileged fields except allowed ones.
      // isMember is admin-managed: users set it once (at create, or on a doc that lacks it), then only admins may change it.
      // Check changed keys, not all keys: existing docs hold isMember and createdAt, which must stay untouched.
      allow update: if isSignedIn() && request.auth.uid == uid
        && emailMatchesAuth()
        && changedOnly([
          'displayName','email','photoURL','isMember','studentStatus','campus','university','expectedGraduationYear','linkedin','github','website','bio','name','gender','program','heardOfUs','newsletter','lookingForJob','privacyAcceptedAt','marketingOptIn','analyticsOptIn','partnerContactOptIn','updatedAt','unsubscribedFromEmails'
        ])
        && (!('isMember' in resource.data) || request.resource.data.get('isMember', null) == resource.data.isMember)
        && partnerVisibleFieldsOk(request.resource.data)
        && cvOptInKept(uid);

      // Admin profile edits go through /api/admin/members/profile (audit-logged,
      // never the member's email or consent choices). From the client an admin
      // may only record attendance history on an existing profile; never create
      // one, so an erased member stays erased. Deleting a profile is server-only
      // (lib/account-erasure), so a member is never half-erased with their CV
      // still shared.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventHistory','updatedAt']);
      allow delete: if false;
    }

    // MEMBER CVS — shared with partners on consent; written only by /api/account/cv (Admin SDK).
    match /cvs/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // PARTNER ALLOWLIST — keyed by lowercased email. A signed-in user may read only
    // the entry for their own verified email (so the client knows it is a partner);
    // CV access itself is re-checked server-side on every request.
    match /partnerAccounts/{email} {
      allow read: if isAdmin()
        || (isSignedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == email);
      // Server-only (tools/partnerAccess.ts): an entry is bound to a vetted account.
      allow write: if false;
    }

    // EVENTS
    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();

      // Full create/update/delete restricted to admins. currentRegistrations
      // is maintained server-side (Admin SDK) when registrations change.
      allow create, update, delete: if isAdmin();
    }

    // TEAM MEMBERS
    match /teamMembers/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // BLOG POSTS
    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // SHOWCASE PROJECTS — community gallery of member AI work
    match /showcaseProjects/{projectId} {
      // Public only sees published projects; admins see all (incl. drafts).
      // A member may also read their own submission so they can follow it
      // through review instead of guessing whether it was ever seen.
      allow read: if resource.data.published == true
        || isAdmin()
        || (isSignedIn() && resource.data.creatorUserId == request.auth.uid);

      // Members may submit their own work, but only as an unpublished,
      // non-featured, zero-vote draft — they cannot self-publish, self-feature,
      // or seed votes.
      allow create: if isMember()
        && request.resource.data.creatorUserId == request.auth.uid
        && request.resource.data.published == false
        && request.resource.data.featured == false
        && request.resource.data.votes == 0
        && request.resource.data.keys().hasOnly([
          'title','slug','description','details','category','creatorUserId','creatorName',
          'links','coverImage','coverImagePath','tags','votes','published',
          'featured','createdAt','updatedAt'
        ])
        // Sizes, so the form is not the only gate. Keep in step with SHOWCASE_LIMITS in types/index.ts.
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 600
        && strWithin(request.resource.data, 'details', 4000)
        && strWithin(request.resource.data, 'slug', 100)
        && strWithin(request.resource.data, 'creatorName', 120)
        && strWithin(request.resource.data, 'coverImage', 1000)
        && strWithin(request.resource.data, 'coverImagePath', 500)
        // Only a cover in the member's own upload folder: an admin deleting the
        // draft later removes this path with admin rights.
        && (!('coverImagePath' in request.resource.data)
          || (request.resource.data.coverImagePath.matches('showcase/' + request.auth.uid + '/[^/]+')
            && !request.resource.data.coverImagePath.matches('.*/[.][.]?')))
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 64
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 64
        && request.resource.data.links is map
        && strWithin(request.resource.data.links, 'github', 500)
        && strWithin(request.resource.data.links, 'website', 500)
        && strWithin(request.resource.data.links, 'demo', 500)
        && strWithin(request.resource.data.links, 'video', 500)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && tagWithin(request.resource.data.tags, 0, 30)
        && tagWithin(request.resource.data.tags, 1, 30)
        && tagWithin(request.resource.data.tags, 2, 30)
        && tagWithin(request.resource.data.tags, 3, 30)
        && tagWithin(request.resource.data.tags, 4, 30);

      // Admins may create projects directly, including published ones ("New Project" in the admin tab).
      allow create: if isAdmin();

      // Publish/feature/edit/delete is admin-only
      allow update, delete: if isAdmin();
    }

    // SHOWCASE VOTES — per-member vote records (idempotency for the vote API).
    // The server writes via the Admin SDK; clients only ever call the API route,
    // so all direct client writes are denied (defense-in-depth against vote
    // doc-ID/forgery abuse).
    match /showcaseVotes/{voteId} {
      allow read, create, update, delete: if isAdmin();
    }

    // JOBS
    match /jobs/{jobId} {
      // Read if published or admin
      allow read: if resource.data.published == true || isAdmin();
      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // FAQ
    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // BOARD POSITIONS (public listing on apply page; admins manage)
    match /board-positions/{positionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // BOARD APPLICATIONS (submissions; API may write via Admin SDK — client read/list admin-only)
    // Deleting goes through /api/admin/board-applications, which removes the files and logs it.
    match /boardApplications/{applicationId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // APPLICATION CAMPAIGNS — public read only for open campaigns (so applicants see them); admin read/write
    match /applicationCampaigns/{campaignId} {
      allow read: if isAdmin() || resource.data.status == 'open';
      allow create, update, delete: if isAdmin();
    }

    // CAMPAIGN QUESTIONS — public read (so applicants see form questions); admin write
    match /campaignQuestions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // TEAM APPLICATIONS (API writes via Admin SDK — admins read all, applicants read their own)
    // Deleting goes through /api/admin/team-applications, which removes the resume and locks and logs it.
   match /teamApplications/{applicationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
   }

    // REGISTRATION QUESTIONS (global)
    match /registrationQuestions/{rqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // EVENT CUSTOM QUESTIONS (per-event)
    match /eventCustomQuestions/{cqId} {
      // Publicly readable to render forms
      allow read: if true;

      // Only admins may write, with strict schema validation
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['eventId','question','type','options','required','order'])
        && validEventCustomQuestion(request.resource.data);

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['eventId','question','type','options','required','order'])
        && validEventCustomQuestion(request.resource.data)
        // eventId must not change once created
        && request.resource.data.eventId == resource.data.eventId;

      allow delete: if isAdmin();
    }

    // REGISTRATIONS
    // Registrations are created, cancelled, declined, and removed via server
    // routes (Admin SDK), which enforce capacity, duplicates, deadlines, and
    // keep events.currentRegistrations consistent. Clients can only read.
    match /registrations/{regId} {
      // Users can read their own registrations; admins can read all
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Admin full update (invitation flow)
      allow update: if isAdmin();
    }

    // APPEND-ONLY ADMIN AUDIT TRAIL — written only by the server (Admin SDK)
    match /adminAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // EVENT ATTENDANCE — admin-only so public event reads never expose attendee IDs
    match /eventAttendance/{eventId} {
      allow read, write: if isAdmin();
    }

    // APPLICATION LIMITS (anti-spam cooldown & campaign locks — admin cleanup on deletion)
    match /applicationUserLimits/{emailHash} {
      allow read, write, delete: if isAdmin();
    }
    match /applicationCampaignLocks/{lockKey} {
      allow read, write, delete: if isAdmin();
    }

    // ANALYTICS (client-side dedup with localStorage; guarded increments)
    // Events: unique clicks (increment-only)
    match /analyticsEvents/{eventId} {
      // Admin can read analytics; you can open reads if you want
      allow read: if isAdmin();

      // Create initial doc with clicks:1, only for an event that exists, so
      // anonymous writes can't fill the collection with arbitrary ids.
      allow create: if exists(/databases/$(database)/documents/events/$(eventId))
        && request.resource.data.keys().hasOnly(['clicks', 'externalRegistrationClicks', 'updatedAt'])
        && request.resource.data.clicks == 1
        && (!('externalRegistrationClicks' in request.resource.data)
          || request.resource.data.externalRegistrationClicks in [0, 1])
        && request.resource.data.updatedAt == request.time;

      // Update: only clicks (+1) or externalRegistrationClicks (+1) and updatedAt allowed
      allow update: if changedOnly(['clicks', 'externalRegistrationClicks', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.clicks == resource.data.clicks + 1
            && request.resource.data.get('externalRegistrationClicks', null) == resource.data.get('externalRegistrationClicks', null)
          )
          || (
            // externalRegistrationClicks +1, treating a missing/null count as 0.
            request.resource.data.get('externalRegistrationClicks', 0)
              == (resource.data.get('externalRegistrationClicks', 0) == null ? 0 : resource.data.get('externalRegistrationClicks', 0)) + 1
            && request.resource.data.clicks == resource.data.clicks
          )
        );

      // No deletes from clients
      allow delete: if isAdmin();
    }

    // Jobs: unique clicks (increment-only)
    match /analyticsJobs/{jobId} {
      allow read: if isAdmin();

      allow create: if exists(/databases/$(database)/documents/jobs/$(jobId))
        && request.resource.data.keys().hasOnly(['clicks', 'updatedAt'])
        && request.resource.data.clicks == 0
        && request.resource.data.updatedAt == request.time;
      allow update: if changedOnly(['clicks', 'updatedAt'])
        && request.resource.data.clicks == resource.data.clicks + 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // Blogs: unique reads (increment-only)
    match /analyticsBlogs/{blogId} {
      allow read: if isAdmin();

      // reads == 0 (admin post-creation seed) or 1 (first visitor read) allowed.
      allow create: if exists(/databases/$(database)/documents/blogPosts/$(blogId))
        && request.resource.data.keys().hasOnly(['reads', 'updatedAt'])
        && (request.resource.data.reads == 0 || request.resource.data.reads == 1)
        && request.resource.data.updatedAt == request.time;
      allow update: if changedOnly(['reads', 'updatedAt'])
        && request.resource.data.reads == resource.data.reads + 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // BLOG REACTIONS - public engagement counters. ABUSE NOTE: writes require a signed-in user — client localStorage dedup is not a security boundary (future: App Check, per-user docs).
    match /blogReactions/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['likes', 'dislikes', 'shares', 'updatedAt'])
        && request.resource.data.likes >= 0 && request.resource.data.likes <= 1
        && request.resource.data.dislikes >= 0 && request.resource.data.dislikes <= 1
        && request.resource.data.shares >= 0 && request.resource.data.shares <= 1;

      allow update: if isSignedIn()
        && changedOnly(['likes', 'dislikes', 'shares', 'updatedAt'])
        && request.resource.data.likes >= 0
        && request.resource.data.dislikes >= 0
        && request.resource.data.shares >= 0
        && (
          (resource.data.likes == null && request.resource.data.likes <= 1)
          || request.resource.data.likes == resource.data.likes
          || request.resource.data.likes == resource.data.likes + 1
          || request.resource.data.likes == resource.data.likes - 1
        )
        && (
          (resource.data.dislikes == null && request.resource.data.dislikes <= 1)
          || request.resource.data.dislikes == resource.data.dislikes
          || request.resource.data.dislikes == resource.data.dislikes + 1
          || request.resource.data.dislikes == resource.data.dislikes - 1
        )
        && (
          (resource.data.shares == null && request.resource.data.shares <= 1)
          || request.resource.data.shares == resource.data.shares
          || request.resource.data.shares == resource.data.shares + 1
        );

      allow delete: if isAdmin();
    }

    // MAIL QUEUE for Firebase Trigger Email extension
    match /mail/{messageId} {
      // Server-only: /api/admin/mail queues templated emails and logs each one,
      // so an admin can't send arbitrary mail from the society's address.
      allow create: if false;
      // Optional: allow admins to read messages for debugging
      allow read: if isAdmin();
      // No client updates or deletes
      allow update, delete: if false;
    }

    // AI CHATS - user chat history
    match /ai_chats/{userId}/chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // FAVORITES - user favorite courses
    match /favorites/{userId}/courses/{courseId} {
      // Users can only read/write their own favorites
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // PROGRAM PROGRESS - courses a student has marked passed on a programme map
    match /programProgress/{userId} {
      // Users can only read/write their own progress
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // COURSE CATEGORIES - user-defined categories
    match /course_categories/{userId}/categories/{categoryId} {
      // Users can only read/write their own categories. New ids start with the
      // owner's uid: category_courses is keyed by category id alone, so a
      // borrowed id would open another user's course mapping.
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && categoryId.size() > userId.size() + 1
        && categoryId[0:userId.size() + 1] == userId + '_';
    }

    // CATEGORY COURSES - many-to-many mapping
    // The caller must own a category with this id. Ids with an owner prefix
    // ("<uid>_...") must carry the caller's own uid; legacy un-prefixed ids
    // (created before the prefix rule) still work for the category's owner.
    function ownsCategoryCourses(categoryId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/course_categories/$(request.auth.uid)/categories/$(categoryId)).data.userId == request.auth.uid
        && (!categoryId.matches('[^_]+_.+')
          || categoryId.matches(request.auth.uid + '_.+'));
    }
    match /category_courses/{categoryId}/courses/{courseId} {
      allow read, write: if ownsCategoryCourses(categoryId);
    }

    // AI SETTINGS - admin configuration
    match /config/ai_settings {
      // Anyone can read (used by client for rate limits)
      allow read: if true;
      // Only super admins can write
      allow write: if isSuperAdmin();
    }

    // AI NEWS DESK - internal settings and the used-articles store are only read from the admin dashboard.
    match /config/blog_ai_settings {
      allow read: if isAdmin();
      // Only super admins can change the News Desk settings (as the admin UI says).
      allow write: if isSuperAdmin();
    }
    match /config/blog_news_seen {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // COURSES - course catalog
    // PROGRAM FEEDBACK - error reports on the generated course maps.
    // Anyone may report a mistake
    match /programFeedback/{reportId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin() && changedOnly(['status']);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CONFIG - application configuration (embedding projections, prerequisite graph, etc.)
    match /config/{configId} {
      // Docs with their own rule above are excluded here: rules are OR'd, so
      // this catch-all would otherwise open them (ai_settings writes, and the
      // admin-only News Desk docs entirely).
      allow read: if !(configId in ['blog_ai_settings', 'blog_news_seen']);
      allow write: if isAdmin()
        && !(configId in ['ai_settings', 'blog_ai_settings', 'blog_news_seen']);
    }

    // TRANSCRIPT DATA - user-uploaded academic records (privacy-first)
    match /users/{uid}/transcript_data/{docId} {
      allow read, write, delete: if false;
      //if isSignedIn() && request.auth.uid == uid;
    }
  }
}
